# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ─────────────────────────────────
venv/
.venv/
env/
.env

# ── Jupyter ──────────────────────────────────────────────
.ipynb_checkpoints/

# ── Trained models / large binaries (distribute via Zenodo, not git) ──
*.pth
*.pt
*.ckpt
*.gguf
*.onnx

# ── Experiment outputs (regenerated by experiments/*.py) ──
experiments/outputs/
wandb/
runs/

# ── Local tooling / agent artifacts (DO NOT publish) ─────
.claude/
memory/

# ── OS / editor cruft ────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── LaTeX build artifacts ────────────────────────────────
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/*.toc

# ── Internal / not for public release ────────────────────
CLAUDE.md
docs/
paper/REVISION_RESPONSE_TRACKER.md
paper/RESPONSE_TO_REVIEWERS*
*.docx
