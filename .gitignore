# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ─────────────────────────────────
venv/
.venv/
env/
.env

# ── Jupyter ──────────────────────────────────────────────
.ipynb_checkpoints/

# ── Trained models / large binaries (distribute via Zenodo, not git) ──
*.pth
*.pt
*.ckpt
*.gguf
*.onnx

# ── Experiment outputs: small result files are committed; checkpoints and logs are not ──
experiments/outputs/*.log
experiments/outputs/__pycache__/
experiments/__pycache__/
wandb/
runs/

# ── Local tooling / agent artifacts (DO NOT publish) ─────
.claude/
memory/

# ── OS / editor cruft ────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── LaTeX build artifacts ────────────────────────────────
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/*.toc

# ── Internal / not for public release ────────────────────
CLAUDE.md
docs/
# ── Manuscript sources are kept out of the public repository ──
paper/
*.docx
